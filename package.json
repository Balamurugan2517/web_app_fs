{
  "name": "fashion-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\"",
    "docs": "typedoc",
    "prepare": "husky",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/migrate.mjs --seed",
    "admin:create": "node scripts/create-admin.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7",
    "pg": "^8.13.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "^5",
    "@types/pg": "^8.11.10",
    "@types/nodemailer": "^6.4.17",
    "@playwright/test": "^1.49.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
