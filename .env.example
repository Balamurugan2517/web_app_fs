# ==== Copy this file to .env.local and fill in. NEVER commit .env.local ====
# Every value is explained in docs/internal/Internal_04_Razorpay_Shiprocket_Config_Guide.md

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (PostgreSQL). Local: docker compose up -d db ---
DATABASE_URL=postgres://luxe:luxe_dev_password@localhost:5432/luxe_thread
DATABASE_SSL=false

# --- Admin sessions & background jobs (long random text: openssl rand -hex 32) ---
SESSION_SECRET=super_secret_session_key_1234567890_abcdef
JOBS_SECRET=super_secret_jobs_key_1234567890_abcdef

# --- Razorpay (TEST keys while testing: rzp_test_...) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_FEE_PERCENT=2

# --- Shiprocket (create a separate API user: Settings > API) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_AUTO_CREATE=true

# --- Cash on Delivery ---
COD_ENABLED=false
COD_MAX_ORDER_VALUE=25000

# --- Notifications (all optional; a channel that is not configured is simply skipped) ---
SMTP_URL=
MAIL_FROM="Luxe & Thread <orders@your-domain.in>"
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# --- Uploaded product photos (keep OUTSIDE the code folder and back it up) ---
UPLOAD_DIR=./uploads
